# Treading-AI Configuration Environment Variables
PROJECT_NAME="Treading-AI"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Data Directories
DATA_RAW_DIR="data/raw"
DATA_PROCESSED_DIR="data/processed"
DATA_FEATURES_DIR="data/features"
REPORTS_DIR="reports"

# Historical Data Source Defaults
DEFAULT_SYMBOL="XAUUSD"
HISTDATA_BASE_URL="https://www.histdata.com"
HISTDATA_DOWNLOAD_URL="https://www.histdata.com/get.php"

# Hardware Constraints Optimization
# Intel Core i7-10610U (4 cores / 8 threads), 16GB RAM, CPU-only
NUM_WORKERS=4
CHUNK_SIZE_ROWS=100000
