# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.local

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Project Data (Keep large datasets out of Git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/features/*
!data/features/.gitkeep

# Generated reports & figures (Keep reports directory tracked)
reports/*.json
reports/*.csv
reports/*.png
!reports/.gitkeep

# System & OS
.DS_Store
Thumbs.db
